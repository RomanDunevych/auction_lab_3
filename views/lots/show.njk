{% extends "layout.njk" %}

{% block content %}
{% from "macros.njk" import statusBadge, eventBadge %}
{% from "forms.njk" import text, select %}

<div class="page-head">
  <div>
    <p class="breadcrumbs"><a href="/lots">Лоти</a> / {{ lot.category.name }}</p>
    <h1>{{ lot.title }} {{ statusBadge(lot.status) }}</h1>
  </div>
  <div class="actions">
    <a class="btn" href="/lots/{{ lot.id }}/edit">Редагувати</a>
    <form method="post" action="/lots/{{ lot.id }}/delete" class="inline"
          onsubmit="return confirm('Видалити лот разом зі ставками та історією?');">
      <button class="btn btn-danger" type="submit">Видалити</button>
    </form>
  </div>
</div>

<div class="two-col">
  <section class="card">
    <h2>Інформація про лот</h2>
    {% if lot.description %}<p>{{ lot.description | escape | nl2br }}</p>{% endif %}
    <dl class="details">
      <dt>Поточна ціна</dt><dd class="price">{{ lot.currentPrice | money }}</dd>
      <dt>Початкова ціна</dt><dd>{{ lot.startPrice | money }}</dd>
      <dt>Мінімальний крок</dt><dd>{{ lot.minStep | money }}</dd>
      <dt>Початок торгів</dt><dd>{{ lot.startTime | date }}</dd>
      <dt>Завершення торгів</dt><dd>{{ lot.endTime | date }}</dd>
      <dt>Продавець</dt><dd><a href="/users/{{ lot.seller.id }}">{{ lot.seller.username }}</a></dd>
      {% if lot.winner %}
      <dt>Переможець</dt><dd><a href="/users/{{ lot.winner.id }}">{{ lot.winner.username }}</a></dd>
      {% endif %}
    </dl>
  </section>

  <section class="card">
    <h2>Зробити ставку</h2>
    {% if canBid %}
      {# Форма без клієнтської валідації: усі перевірки виконує сервер (POST /bids) #}
      <form method="post" action="/bids" class="form" novalidate>
        <input type="hidden" name="lotId" value="{{ lot.id }}">
        {{ select('userId', 'Користувач', {}, {}, userOptions) }}
        {{ text('amount', 'Сума ставки, грн', { 'amount': minBid }, {}, hint='Мінімально допустима ставка: ' ~ (minBid | money), inputmode='decimal') }}
        <button class="btn btn-primary" type="submit">Зробити ставку</button>
      </form>
    {% else %}
      <p class="muted">Приймання ставок недоступне: лот не активний або торги ще не розпочалися чи вже завершені.</p>
    {% endif %}
  </section>
</div>

<h2>Ставки ({{ lot.bids | length }})</h2>
{% if hasBids %}
<table class="table">
  <thead><tr><th>#</th><th>Користувач</th><th>Сума</th><th>Час</th></tr></thead>
  <tbody>
    {% for bid in lot.bids %}
    <tr class="{{ 'top-row' if loop.first }}">
      <td>{{ loop.index }}</td>
      <td><a href="/users/{{ bid.bidder.id }}">{{ bid.bidder.username }}</a></td>
      <td>{{ bid.amount | money }}</td>
      <td>{{ bid.createdAt | date }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% else %}
<p class="muted">Ставок ще немає.</p>
{% endif %}

<h2>Історія подій</h2>
{% if history.length %}
<table class="table">
  <thead><tr><th>Час</th><th>Подія</th><th>Користувач</th><th>Сума</th></tr></thead>
  <tbody>
    {% for h in history %}
    <tr>
      <td>{{ h.createdAt | date }}</td>
      <td>{{ eventBadge(h.eventType) }}</td>
      <td>{{ h.user.username }}</td>
      <td>{{ h.amount | money }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% else %}
<p class="muted">Подій ще немає.</p>
{% endif %}
{% endblock %}
